<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud backup excludes app preferences and the SQLite database: they hold the user's Anthropic API key and
    friends' data, which we don't want sitting in a third-party backup. Device-to-device transfer keeps both,
    so moving to a new phone still works. (An <include> list is exhaustive: anything not listed isn't transferred.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
