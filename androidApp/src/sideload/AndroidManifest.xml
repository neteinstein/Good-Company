<?xml version="1.0" encoding="utf-8"?>
<!--
    Sideload-only additions. READ_CALL_LOG is a Google Play *restricted* permission (default dialer apps
    only), so it must never reach the Play build. Used to match calls with friends' phone numbers.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
</manifest>
