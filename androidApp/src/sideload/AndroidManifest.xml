<?xml version="1.0" encoding="utf-8"?>
<!--
    Sideload-only additions, never in the Play build:
    - READ_CALL_LOG is a Google Play *restricted* permission (default dialer apps only). Used to match calls
      with friends' phone numbers.
    - REQUEST_INSTALL_PACKAGES + the FileProvider below let Settings → "App updates" download a newer sideload build
      and hand it to Android's installer. Google Play restricts that permission too.
    There is no READ_CONTACTS in any build: people are added with the system contact picker (owner decision
    2026-11-08, so the sideload build behaves like the Play one).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Shares the downloaded update APK (cache/updates/) with the package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
