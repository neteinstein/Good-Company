<?xml version="1.0" encoding="utf-8"?>
<!--
    Sideload-only additions, never in the Play build:
    - READ_CALL_LOG is a Google Play *restricted* permission (default dialer apps only). Used to match calls
      with friends' phone numbers.
    - READ_CONTACTS (full address-book sync). The Play build adds people with the system contact picker,
      which needs no permission (owner decision 2026-11-07).
    - WRITE_CONTACTS: mirrors what the app knows about a friend (birthday, kids, events, notes) onto their contact, so
      it can be read in the Contacts app (owner decision 2026-11-08). Never in the Play build.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
</manifest>
