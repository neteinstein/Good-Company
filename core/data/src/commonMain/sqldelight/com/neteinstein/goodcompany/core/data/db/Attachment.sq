-- Shared things kept on a friend's or a circle's page (decisions D6, F12). Exactly one of friend_id and circle_id is
-- set, and the attachment goes with its friend or circle. kind / photo_platform / interaction_type are enum names;
-- thumbnail is a base64 JPEG like friend_photo; photo_ref is an Android content URI or an iOS PHAsset identifier.
-- log_id is the hangout id or the interactions' batch id (or the one interaction's id) when it counts as contact.

CREATE TABLE attachment (
    id TEXT NOT NULL PRIMARY KEY,
    friend_id TEXT REFERENCES friend(id) ON DELETE CASCADE,
    circle_id TEXT REFERENCES friend_group(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('TEXT', 'LINK', 'PHOTO')),
    text TEXT,
    url TEXT,
    title TEXT,
    photo_platform TEXT CHECK (photo_platform IN ('ANDROID', 'IOS')),
    photo_ref TEXT,
    thumbnail TEXT,
    caption TEXT NOT NULL DEFAULT '',
    at INTEGER NOT NULL,
    counts_as_interaction INTEGER NOT NULL DEFAULT 0 CHECK (counts_as_interaction IN (0, 1)),
    interaction_type TEXT CHECK (interaction_type IN ('CALL', 'WHATSAPP', 'MEETUP', 'MESSAGE', 'EMAIL', 'VIDEO_CALL')),
    log_id TEXT,
    created_at INTEGER NOT NULL,
    CHECK ((friend_id IS NULL) <> (circle_id IS NULL)),
    CHECK ((photo_platform IS NULL) = (photo_ref IS NULL))
);

CREATE INDEX attachment_friend_at ON attachment(friend_id, at);

CREATE INDEX attachment_circle_at ON attachment(circle_id, at);

allAttachments:
SELECT * FROM attachment ORDER BY at, id;

upsertAttachment:
INSERT OR REPLACE INTO attachment (
    id, friend_id, circle_id, kind, text, url, title, photo_platform, photo_ref, thumbnail, caption, at,
    counts_as_interaction, interaction_type, log_id, created_at
)
SELECT :id, :friendId, :circleId, :kind, :text, :url, :title, :photoPlatform, :photoRef, :thumbnail, :caption, :at,
    :countsAsInteraction, :interactionType, :logId, :createdAt
WHERE (:friendId IS NOT NULL AND EXISTS (SELECT 1 FROM friend WHERE id = :friendId))
    OR (:circleId IS NOT NULL AND EXISTS (SELECT 1 FROM friend_group WHERE id = :circleId));

deleteAttachment:
DELETE FROM attachment WHERE id = ?;

deleteAllAttachments:
DELETE FROM attachment;
