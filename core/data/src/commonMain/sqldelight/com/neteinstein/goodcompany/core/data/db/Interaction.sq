-- Evidence of contact (calls, messages, emails, video calls, WhatsApp days), journal entries, and imported chat lines
-- kept as AI context. Automatic interactions and chat lines are de-duplicated (UNIQUE + INSERT OR IGNORE), trimmed by
-- age, and everything goes with the friend.

CREATE TABLE interaction (
    id TEXT NOT NULL PRIMARY KEY,
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    type TEXT NOT NULL,
    at INTEGER NOT NULL,
    note TEXT NOT NULL DEFAULT '',
    source TEXT NOT NULL,
    duration_seconds INTEGER,
    batch_id TEXT,
    message_count INTEGER
);

CREATE INDEX interaction_friend_at ON interaction(friend_id, at);

CREATE INDEX interaction_at ON interaction(at);

-- Call-log sync and chat imports stay idempotent: the same call or chat day is stored once.
CREATE UNIQUE INDEX interaction_automatic ON interaction(friend_id, type, at) WHERE source IN ('CALL_LOG', 'CHAT_IMPORT');

CREATE INDEX interaction_batch ON interaction(batch_id);

CREATE TABLE conversation_message (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    at INTEGER NOT NULL,
    from_me INTEGER NOT NULL CHECK (from_me IN (0, 1)),
    text TEXT NOT NULL,
    UNIQUE (friend_id, at, from_me, text)
);

CREATE INDEX conversation_message_friend_at ON conversation_message(friend_id, at);

-- Dated notes about a friend. Not an interaction: they never count as contact.
CREATE TABLE journal_entry (
    id TEXT NOT NULL PRIMARY KEY,
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    at INTEGER NOT NULL,
    text TEXT NOT NULL
);

CREATE INDEX journal_entry_friend_at ON journal_entry(friend_id, at);

allInteractions:
SELECT * FROM interaction ORDER BY at, rowid;

allMessages:
SELECT * FROM conversation_message ORDER BY friend_id, at, rowid;

-- Automatic rows that are already stored are skipped (same id, or same friend, type and time).
insertInteraction:
INSERT OR IGNORE INTO interaction (id, friend_id, type, at, note, source, duration_seconds, batch_id, message_count)
SELECT :id, :friendId, :type, :at, :note, :source, :durationSeconds, :batchId, :messageCount
WHERE EXISTS (SELECT 1 FROM friend WHERE id = :friendId);

deleteInteraction:
DELETE FROM interaction WHERE id = ?;

-- Keeps the newest :keep interactions.
trimInteractions:
DELETE FROM interaction WHERE rowid IN (
    SELECT rowid FROM interaction ORDER BY at DESC, rowid DESC LIMIT -1 OFFSET :keep
);

insertMessage:
INSERT OR IGNORE INTO conversation_message (friend_id, at, from_me, text)
SELECT :friendId, :at, :fromMe, :text WHERE EXISTS (SELECT 1 FROM friend WHERE id = :friendId);

-- Keeps the newest :keep chat lines of one friend.
trimMessages:
DELETE FROM conversation_message WHERE friend_id = :friendId AND rowid NOT IN (
    SELECT rowid FROM conversation_message WHERE friend_id = :friendId ORDER BY at DESC, rowid DESC LIMIT :keep
);

deleteAllInteractions:
DELETE FROM interaction;

deleteAllMessages:
DELETE FROM conversation_message;

allJournal:
SELECT * FROM journal_entry ORDER BY at, id;

upsertJournal:
INSERT OR REPLACE INTO journal_entry (id, friend_id, at, text)
SELECT :id, :friendId, :at, :text WHERE EXISTS (SELECT 1 FROM friend WHERE id = :friendId);

deleteJournal:
DELETE FROM journal_entry WHERE id = ?;

deleteAllJournal:
DELETE FROM journal_entry;
