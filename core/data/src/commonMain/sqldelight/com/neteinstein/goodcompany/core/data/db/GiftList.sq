-- Gift lists per occasion (F8, issue #42). A list has people (gift_list_entry, with an optional budget) and, per
-- person, the gifts planned for them (gift_list_item). gift_id is one of that friend's rows in gift, without a foreign
-- key: a friend's gifts are rewritten on every save, so an item whose gift is gone is skipped when read. A list is
-- saved whole (delete, then insert), so its people and items always match what the app holds. Part of the backup.

CREATE TABLE gift_list (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    occasion TEXT CHECK (occasion IN ('BIRTHDAY', 'CHRISTMAS', 'THANK_YOU', 'JUST_BECAUSE')),
    occasion_date TEXT,
    created_at INTEGER NOT NULL
);

CREATE TABLE gift_list_entry (
    list_id TEXT NOT NULL REFERENCES gift_list(id) ON DELETE CASCADE,
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    budget REAL,
    position INTEGER NOT NULL,
    PRIMARY KEY (list_id, friend_id)
);

CREATE INDEX gift_list_entry_friend ON gift_list_entry(friend_id);

CREATE TABLE gift_list_item (
    list_id TEXT NOT NULL,
    friend_id TEXT NOT NULL,
    gift_id TEXT NOT NULL,
    status TEXT NOT NULL DEFAULT 'TO_BUY' CHECK (status IN ('TO_BUY', 'BOUGHT', 'GIVEN')),
    position INTEGER NOT NULL,
    PRIMARY KEY (list_id, friend_id, gift_id),
    FOREIGN KEY (list_id, friend_id) REFERENCES gift_list_entry(list_id, friend_id) ON DELETE CASCADE
);

allLists:
SELECT * FROM gift_list ORDER BY created_at, id;

allEntries:
SELECT * FROM gift_list_entry ORDER BY list_id, position;

allItems:
SELECT * FROM gift_list_item ORDER BY list_id, friend_id, position;

insertList:
INSERT INTO gift_list (id, title, occasion, occasion_date, created_at) VALUES (?, ?, ?, ?, ?);

insertEntry:
INSERT OR IGNORE INTO gift_list_entry (list_id, friend_id, budget, position)
SELECT :listId, :friendId, :budget, :position WHERE EXISTS (SELECT 1 FROM friend WHERE id = :friendId);

insertItem:
INSERT OR IGNORE INTO gift_list_item (list_id, friend_id, gift_id, status, position)
SELECT :listId, :friendId, :giftId, :status, :position
WHERE EXISTS (SELECT 1 FROM gift_list_entry WHERE list_id = :listId AND friend_id = :friendId);

deleteList:
DELETE FROM gift_list WHERE id = ?;

deleteAllLists:
DELETE FROM gift_list;
