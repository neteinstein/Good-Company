-- A friend and everything that belongs only to them. Every list on the domain `Friend` is a child table keyed by
-- (friend_id, …) with a `position` that keeps the list's order; child rows go when the friend goes (ON DELETE CASCADE).
-- Flags are INTEGER 0/1, enums TEXT with a CHECK, dates ISO TEXT (yyyy-mm-dd), instants epoch milliseconds.

CREATE TABLE friend (
    id TEXT NOT NULL PRIMARY KEY,
    position INTEGER NOT NULL,
    name TEXT NOT NULL,
    contact_id TEXT,
    birthday_month INTEGER CHECK (birthday_month BETWEEN 1 AND 12),
    birthday_day INTEGER CHECK (birthday_day BETWEEN 1 AND 31),
    birthday_year INTEGER,
    is_close_friend INTEGER NOT NULL CHECK (is_close_friend IN (0, 1)),
    notify_birthday INTEGER NOT NULL CHECK (notify_birthday IN (0, 1)),
    notes TEXT NOT NULL,
    meet_every_days INTEGER,
    suggest_events INTEGER NOT NULL CHECK (suggest_events IN (0, 1)),
    is_orphaned INTEGER NOT NULL CHECK (is_orphaned IN (0, 1)),
    circle TEXT CHECK (circle IN ('INNER', 'CLOSE', 'GOOD')),
    snoozed_until TEXT,
    catch_up_paused INTEGER NOT NULL CHECK (catch_up_paused IN (0, 1)),
    contact_counts_as_catch_up INTEGER NOT NULL CHECK (contact_counts_as_catch_up IN (0, 1)),
    -- Issue #20 ("About"). met_on is yyyy-mm-dd, or yyyy-mm when the day isn't known. introduced_by_friend_id is not a
    -- foreign key on purpose: when that friend goes, the name stays. preferred_channel is a ContactChannel name (no CHECK:
    -- SQLDelight can't parse one on an added column, and the migration has to match this table).
    job TEXT NOT NULL DEFAULT '',
    lives_in TEXT NOT NULL DEFAULT '',
    met_place TEXT,
    met_on TEXT,
    introduced_by_friend_id TEXT,
    introduced_by_name TEXT,
    preferred_channel TEXT,
    -- Issue #39 (F6, F18): what they are to you (a LinkType name) and the words used for them (a Pronouns name).
    -- No CHECK, like preferred_channel: unknown values read as null in the mapper.
    relation_to_me TEXT,
    pronouns TEXT,
    CHECK ((birthday_month IS NULL) = (birthday_day IS NULL))
);

CREATE INDEX friend_contact_id ON friend(contact_id);

-- `normalized` is PhoneMatcher.key(number): the last significant digits, used to match calls and shares to a friend.
CREATE TABLE friend_phone (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    number TEXT NOT NULL,
    normalized TEXT,
    PRIMARY KEY (friend_id, position)
);

CREATE INDEX friend_phone_normalized ON friend_phone(normalized);

-- Tastes by kind: LIKE ("Other likes"), DISLIKE ("Doesn't like"), FOOD, DRINK, INTEREST. `added_at` is when it was
-- added (Friend.likesAddedAt / foodAddedAt…); null for dislikes and older entries.
CREATE TABLE friend_taste (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    kind TEXT NOT NULL CHECK (kind IN ('LIKE', 'DISLIKE', 'FOOD', 'DRINK', 'INTEREST')),
    position INTEGER NOT NULL,
    taste TEXT NOT NULL,
    added_at INTEGER,
    PRIMARY KEY (friend_id, kind, position)
);

CREATE INDEX friend_taste_kind_taste ON friend_taste(kind, taste);

CREATE TABLE friend_occasion (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    occasion TEXT NOT NULL CHECK (occasion IN ('WEEKDAY_LUNCH', 'COFFEE', 'DINNER', 'DRINKS', 'OUTDOORS', 'SPORTS', 'CULTURE', 'FAMILY_TIME')),
    position INTEGER NOT NULL,
    PRIMARY KEY (friend_id, occasion)
);

CREATE TABLE kid (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    position INTEGER NOT NULL,
    name TEXT NOT NULL,
    birthday_month INTEGER CHECK (birthday_month BETWEEN 1 AND 12),
    birthday_day INTEGER CHECK (birthday_day BETWEEN 1 AND 31),
    birthday_year INTEGER,
    added_at INTEGER,
    PRIMARY KEY (friend_id, id),
    CHECK ((birthday_month IS NULL) = (birthday_day IS NULL))
);

CREATE TABLE kid_like (
    friend_id TEXT NOT NULL,
    kid_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    liked TEXT NOT NULL,
    PRIMARY KEY (friend_id, kid_id, position),
    FOREIGN KEY (friend_id, kid_id) REFERENCES kid(friend_id, id) ON DELETE CASCADE
);

CREATE TABLE important_event (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    position INTEGER NOT NULL,
    title TEXT NOT NULL,
    date TEXT NOT NULL,
    remind_days_before INTEGER NOT NULL,
    added_at INTEGER,
    PRIMARY KEY (friend_id, id)
);

CREATE INDEX important_event_date ON important_event(date);

-- A gift idea (given_on null) or a gift given. for_kid_id points at one of this friend's kids. url and price come
-- from a shop link shared as a gift idea (F17).
CREATE TABLE gift (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    position INTEGER NOT NULL,
    title TEXT NOT NULL,
    note TEXT NOT NULL,
    for_kid_id TEXT,
    given_on TEXT,
    occasion TEXT CHECK (occasion IN ('BIRTHDAY', 'CHRISTMAS', 'THANK_YOU', 'JUST_BECAUSE')),
    url TEXT,
    price TEXT,
    PRIMARY KEY (friend_id, id),
    FOREIGN KEY (friend_id, for_kid_id) REFERENCES kid(friend_id, id)
);

CREATE TABLE life_update (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    position INTEGER NOT NULL,
    text TEXT NOT NULL,
    added_at INTEGER NOT NULL,
    PRIMARY KEY (friend_id, id)
);

CREATE TABLE feed (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    url TEXT NOT NULL,
    position INTEGER NOT NULL,
    title TEXT NOT NULL,
    site_url TEXT,
    checked_at INTEGER,
    PRIMARY KEY (friend_id, url)
);

CREATE TABLE feed_item (
    friend_id TEXT NOT NULL,
    feed_url TEXT NOT NULL,
    id TEXT NOT NULL,
    position INTEGER NOT NULL,
    title TEXT NOT NULL,
    link TEXT,
    published_at INTEGER,
    PRIMARY KEY (friend_id, feed_url, id),
    FOREIGN KEY (friend_id, feed_url) REFERENCES feed(friend_id, url) ON DELETE CASCADE
);

-- The contact photo (issue #15): one small thumbnail per friend, base64 TEXT (not a BLOB, which the web worker would
-- hand back as a typed array). Its own table so the friend row stays small.
CREATE TABLE friend_photo (
    friend_id TEXT NOT NULL PRIMARY KEY REFERENCES friend(id) ON DELETE CASCADE,
    image_base64 TEXT NOT NULL
);

-- Emails: from_contact ones follow the address book, typed ones are kept (ContactMerger).
CREATE TABLE friend_email (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    address TEXT NOT NULL,
    from_contact INTEGER NOT NULL CHECK (from_contact IN (0, 1)),
    PRIMARY KEY (friend_id, position)
);

-- Family other than kids (kids keep their own table).
CREATE TABLE relative (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    id TEXT NOT NULL,
    position INTEGER NOT NULL,
    relation TEXT NOT NULL CHECK (relation IN ('PARTNER', 'PARENT', 'SIBLING', 'PET', 'OTHER')),
    name TEXT NOT NULL,
    birthday_month INTEGER CHECK (birthday_month BETWEEN 1 AND 12),
    birthday_day INTEGER CHECK (birthday_day BETWEEN 1 AND 31),
    birthday_year INTEGER,
    note TEXT NOT NULL,
    notify_birthday INTEGER NOT NULL CHECK (notify_birthday IN (0, 1)),
    added_at INTEGER,
    PRIMARY KEY (friend_id, id),
    CHECK ((birthday_month IS NULL) = (birthday_day IS NULL))
);

CREATE TABLE relative_like (
    friend_id TEXT NOT NULL,
    relative_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    liked TEXT NOT NULL,
    PRIMARY KEY (friend_id, relative_id, position),
    FOREIGN KEY (friend_id, relative_id) REFERENCES relative(friend_id, id) ON DELETE CASCADE
);

-- "More about <name>": free label/value lines.
CREATE TABLE custom_field (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    id TEXT NOT NULL,
    label TEXT NOT NULL,
    value TEXT NOT NULL,
    PRIMARY KEY (friend_id, position)
);

-- Reads: every row of every table, ordered; FriendMapper assembles the domain aggregates.

allFriends:
SELECT * FROM friend ORDER BY position;

allPhones:
SELECT * FROM friend_phone ORDER BY friend_id, position;

allTastes:
SELECT * FROM friend_taste ORDER BY friend_id, kind, position;

allOccasions:
SELECT * FROM friend_occasion ORDER BY friend_id, position;

allKids:
SELECT * FROM kid ORDER BY friend_id, position;

allKidLikes:
SELECT * FROM kid_like ORDER BY friend_id, kid_id, position;

allEvents:
SELECT * FROM important_event ORDER BY friend_id, position;

allGifts:
SELECT * FROM gift ORDER BY friend_id, position;

allLifeUpdates:
SELECT * FROM life_update ORDER BY friend_id, position;

allFeeds:
SELECT * FROM feed ORDER BY friend_id, position;

allFeedItems:
SELECT * FROM feed_item ORDER BY friend_id, feed_url, position;

allPhotos:
SELECT * FROM friend_photo;

allEmails:
SELECT * FROM friend_email ORDER BY friend_id, position;

allRelatives:
SELECT * FROM relative ORDER BY friend_id, position;

allRelativeLikes:
SELECT * FROM relative_like ORDER BY friend_id, relative_id, position;

allCustomFields:
SELECT * FROM custom_field ORDER BY friend_id, position;

ids:
SELECT id FROM friend;

nextPosition:
SELECT coalesce(max(position), -1) + 1 FROM friend;

-- Writes. upsert keeps the row (and so its rowid and everything that references it); never INSERT OR REPLACE a
-- friend, which would delete it first and cascade away their hangouts, interactions and plans.

upsert:
INSERT INTO friend (
    id, position, name, contact_id, birthday_month, birthday_day, birthday_year, is_close_friend, notify_birthday,
    notes, meet_every_days, suggest_events, is_orphaned, circle, snoozed_until, catch_up_paused, contact_counts_as_catch_up,
    job, lives_in, met_place, met_on, introduced_by_friend_id, introduced_by_name, preferred_channel,
    relation_to_me, pronouns
) VALUES ?
ON CONFLICT (id) DO UPDATE SET
    position = excluded.position,
    name = excluded.name,
    contact_id = excluded.contact_id,
    birthday_month = excluded.birthday_month,
    birthday_day = excluded.birthday_day,
    birthday_year = excluded.birthday_year,
    is_close_friend = excluded.is_close_friend,
    notify_birthday = excluded.notify_birthday,
    notes = excluded.notes,
    meet_every_days = excluded.meet_every_days,
    suggest_events = excluded.suggest_events,
    is_orphaned = excluded.is_orphaned,
    circle = excluded.circle,
    snoozed_until = excluded.snoozed_until,
    catch_up_paused = excluded.catch_up_paused,
    contact_counts_as_catch_up = excluded.contact_counts_as_catch_up,
    job = excluded.job,
    lives_in = excluded.lives_in,
    met_place = excluded.met_place,
    met_on = excluded.met_on,
    introduced_by_friend_id = excluded.introduced_by_friend_id,
    introduced_by_name = excluded.introduced_by_name,
    preferred_channel = excluded.preferred_channel,
    relation_to_me = excluded.relation_to_me,
    pronouns = excluded.pronouns;

delete:
DELETE FROM friend WHERE id = ?;

deleteAll:
DELETE FROM friend;

-- Replacing a friend's children: delete them all (gifts before kids, items before feeds, likes before relatives), then insert the new lists.
deleteChildren {
    DELETE FROM friend_phone WHERE friend_id = :friendId;
    DELETE FROM friend_taste WHERE friend_id = :friendId;
    DELETE FROM friend_occasion WHERE friend_id = :friendId;
    DELETE FROM gift WHERE friend_id = :friendId;
    DELETE FROM kid_like WHERE friend_id = :friendId;
    DELETE FROM kid WHERE friend_id = :friendId;
    DELETE FROM important_event WHERE friend_id = :friendId;
    DELETE FROM life_update WHERE friend_id = :friendId;
    DELETE FROM feed_item WHERE friend_id = :friendId;
    DELETE FROM feed WHERE friend_id = :friendId;
    DELETE FROM friend_photo WHERE friend_id = :friendId;
    DELETE FROM friend_email WHERE friend_id = :friendId;
    DELETE FROM relative_like WHERE friend_id = :friendId;
    DELETE FROM relative WHERE friend_id = :friendId;
    DELETE FROM custom_field WHERE friend_id = :friendId;
}

insertPhone:
INSERT OR REPLACE INTO friend_phone VALUES ?;

insertTaste:
INSERT OR REPLACE INTO friend_taste VALUES ?;

insertOccasion:
INSERT OR REPLACE INTO friend_occasion VALUES ?;

insertKid:
INSERT OR REPLACE INTO kid VALUES ?;

insertKidLike:
INSERT OR REPLACE INTO kid_like VALUES ?;

insertEvent:
INSERT OR REPLACE INTO important_event VALUES ?;

insertGift:
INSERT OR REPLACE INTO gift VALUES ?;

insertLifeUpdate:
INSERT OR REPLACE INTO life_update VALUES ?;

insertFeed:
INSERT OR REPLACE INTO feed VALUES ?;

insertFeedItem:
INSERT OR REPLACE INTO feed_item VALUES ?;

insertPhoto:
INSERT OR REPLACE INTO friend_photo VALUES ?;

insertEmail:
INSERT OR REPLACE INTO friend_email VALUES ?;

insertRelative:
INSERT OR REPLACE INTO relative VALUES ?;

insertRelativeLike:
INSERT OR REPLACE INTO relative_like VALUES ?;

insertCustomField:
INSERT OR REPLACE INTO custom_field VALUES ?;
