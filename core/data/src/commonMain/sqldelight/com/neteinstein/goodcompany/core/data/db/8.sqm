-- Version 8 → 9 (issue #39, F6, F18): links between people, what each friend is to you, and the words used for them.

CREATE TABLE person_link (
    id TEXT NOT NULL PRIMARY KEY,
    from_friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    to_friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    type TEXT NOT NULL CHECK (type IN (
        'PARENT', 'CHILD', 'SIBLING', 'GRANDPARENT', 'GRANDCHILD', 'AUNT_UNCLE', 'NIECE_NEPHEW', 'COUSIN', 'IN_LAW',
        'DATING', 'SPOUSE', 'PARTNER', 'EX', 'FRIEND', 'COLLEAGUE'
    )),
    started_on TEXT,
    ended_on TEXT,
    note TEXT NOT NULL DEFAULT '',
    remind_anniversary INTEGER NOT NULL DEFAULT 0 CHECK (remind_anniversary IN (0, 1)),
    added_at INTEGER,
    CHECK (from_friend_id <> to_friend_id)
);

CREATE INDEX person_link_from ON person_link(from_friend_id);

CREATE INDEX person_link_to ON person_link(to_friend_id);

ALTER TABLE friend ADD COLUMN relation_to_me TEXT;

ALTER TABLE friend ADD COLUMN pronouns TEXT;
