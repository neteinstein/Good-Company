-- Version 34 → 35 (issue #169, decision 2026-11-25 "Postal addresses · home and work"): a person's home and work
-- postal addresses, free text. from_contact ones follow the address book, typed ones are kept; never written back.
-- New table, nothing to backfill.

CREATE TABLE friend_address (
    friend_id TEXT NOT NULL REFERENCES friend(id) ON DELETE CASCADE,
    kind TEXT NOT NULL,
    text TEXT NOT NULL,
    from_contact INTEGER NOT NULL CHECK (from_contact IN (0, 1)),
    PRIMARY KEY (friend_id, kind)
);
