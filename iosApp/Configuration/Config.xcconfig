// Shared build settings for the hand-authored iosApp project.
// TEAM_ID: set your Apple Developer team here (or override in a gitignored Signing.xcconfig / CI env).
TEAM_ID =
BUNDLE_ID = com.neteinstein.goodcompany
APP_NAME = Good Company
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1
// App group shared by the app, the Share Extension and the widget (register it in your Apple Developer account).
APP_GROUP = group.$(BUNDLE_ID)

// Google Drive backup (optional): the iOS OAuth client ID from Google Cloud, e.g.
// 1234567890-abcdef.apps.googleusercontent.com. Leave empty to hide the feature. See docs/GOOGLE_DRIVE.md.
GOOGLE_DRIVE_IOS_CLIENT_ID =

// Local overrides (gitignored): TEAM_ID, GOOGLE_DRIVE_IOS_CLIENT_ID.
#include? "Signing.xcconfig"
